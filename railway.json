{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd server && npm install && npm run build",
    "watchPatterns": [
      "server/**/*",
      "client/src/**/*",
      "client/index.html"
    ]
  },
  "deploy": {
    "startCommand": "cd server && npm run railway",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
